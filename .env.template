# Database configuration
WRT_DB_HOST=<host>
WRT_DB_DATABASE=<database>
WRT_DB_USERNAME=<username>
WRT_DB_PASSWORD=<password>
WRT_DB_PORT=<port>

# CMEMS configuration
CMEMS_USERNAME=<user>
CMEMS_PASSWORD=<password>

# Output path for storing figures (mainly for debugging)
WRT_FIGURE_PATH=<path>

# A* Router configuration (optional)
# Graph cache directory - cached navigation graphs are stored here
# Default: /tmp/wrt_graph_cache
# WRT_ASTAR_CACHE_DIR=/tmp/wrt_graph_cache

# Weather data cache directory - cached weather forecasts stored here
# Default: /tmp/wrt_data
# WRT_DATA_DIR=/tmp/wrt_data